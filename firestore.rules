rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function own(user) { return verified() && request.auth.uid == user; }
    function approved(group) { return verified() && get(/databases/$(database)/documents/groups/$(group)/members/$(request.auth.uid)).data.status == 'approved'; }
    function admin(group) { return approved(group) && get(/databases/$(database)/documents/groups/$(group)/members/$(request.auth.uid)).data.role in ['owner','administrator','publisher']; }
    match /users/{user} {
      allow read: if own(user);
      allow write: if false;
      match /profile/{doc} {
        allow read: if own(user);
        allow write: if false;
      }
      match /personal/{doc} {
        allow read: if own(user);
        allow write: if false;
      }
      match /groupPreferences/{group} {
        allow read: if own(user);
        allow write: if own(user) && request.resource.data.keys().hasOnly(['muted','lastReadAt','lastReadSequence']) &&
          (!('lastReadSequence' in request.resource.data) || (request.resource.data.lastReadSequence is int && request.resource.data.lastReadSequence >= 0));
      }
      match /devices/{device} {
        allow read, delete: if own(user);
        allow create, update: if own(user) && request.resource.data.keys().hasOnly(['token']) && request.resource.data.token is string && request.resource.data.token.size() < 4096;
      }
      match /{collection}/{doc} {
        allow read: if own(user) && collection in ['records','proposals','revisions','groups','attachments'];
        allow write: if false;
      }
    }
    match /groups/{group} {
      allow read: if approved(group);
      allow write: if false;
      match /members/{user} { allow read: if approved(group) || own(user); allow write: if false; }
      match /proposals/{proposal} { allow read: if approved(group); allow write: if false; }
      match /{collection}/{doc} {
        allow read: if approved(group) && collection in ['messages','records','revisions','attachments'];
        allow write: if false;
      }
    }
    // Legacy unscoped collections, invite secrets, leases and configuration are server-only.
    match /{document=**} { allow read, write: if false; }
  }
}
